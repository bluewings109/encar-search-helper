{
  "manifest_version": 3,
  "name": "엔카 매물 목록 상세정보 표시기",
  "version": "0.5.0",
  "description": "엔카 매물 목록에서 상세페이지에서만 보이던 사고이력·보험이력·용도변경이력 정보를 바로 보여줍니다.",
  "host_permissions": [
    "https://api.encar.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.encar.com/dc/dc_carsearchlist.do*",
        "https://www.encar.com/fc/fc_carsearchlist.do*",
        "https://www.encar.com/ev/ev_carsearchlist.do*",
        "https://www.encar.com/tr/tr_carsearchlist.do*"
      ],
      "js": ["src/api.js", "src/render.js", "src/filter.js", "src/mileage.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
